{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Offline classification review plan (derived artifact, not KnowledgeBaseSnapshot)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "date",
    "subject",
    "title",
    "baselinePath",
    "baselineSha256",
    "baselineCommit",
    "schemaPath",
    "priorDecisionsPath",
    "priorQualityPath",
    "tocPath",
    "indexPath",
    "manifestPath",
    "scope",
    "protectedProjectFiles",
    "observations",
    "decisions",
    "pdfVisualChecks",
    "limitations",
    "outputs",
    "ocrInventory"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "date": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "baselinePath": {
      "type": "string",
      "minLength": 1
    },
    "baselineSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baselineCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "schemaPath": {
      "type": "string",
      "minLength": 1
    },
    "priorDecisionsPath": {
      "type": "string",
      "minLength": 1
    },
    "priorQualityPath": {
      "type": "string",
      "minLength": 1
    },
    "tocPath": {
      "type": "string",
      "minLength": 1
    },
    "indexPath": {
      "type": "string",
      "minLength": 1
    },
    "manifestPath": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "years",
        "questionsPerYear",
        "idPrefix"
      ],
      "properties": {
        "years": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        },
        "questionsPerYear": {
          "type": "integer",
          "minimum": 1
        },
        "idPrefix": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "protectedProjectFiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "printedPage",
          "observedSections",
          "observation",
          "method",
          "file",
          "sha256",
          "seq",
          "manifestPath",
          "locator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "printedPage": {
            "type": "integer",
            "minimum": 1
          },
          "observedSections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "const": "agent-visual-inspection; independent-human-review-pending"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "manifestPath": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "oldClassification",
          "newClassification",
          "outcome",
          "evidenceIds",
          "secondarySections",
          "confidence",
          "reason",
          "nextEvidenceNeeded",
          "reasonCode",
          "reviewerType",
          "needsHumanReview",
          "sourceChecks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "oldClassification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "placement",
              "candidates"
            ],
            "properties": {
              "status": {
                "enum": [
                  "unit",
                  "ambiguous"
                ]
              },
              "placement": {
                "type": "object"
              },
              "candidates": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "newClassification": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "unit",
                  "section",
                  "bucket",
                  "subtopic"
                ],
                "properties": {
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "section": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bucket": {
                    "type": "string",
                    "minLength": 1
                  },
                  "subtopic": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "outcome": {
            "enum": [
              "pending",
              "proposed-section"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "secondarySections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "confidence": {
            "enum": [
              "high",
              "insufficient"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "nextEvidenceNeeded": {
            "type": "string",
            "minLength": 1
          },
          "reasonCode": {
            "enum": [
              "direct-evidence",
              "multiple-topics",
              "insufficient-data",
              "figure-review-needed"
            ]
          },
          "reviewerType": {
            "const": "agent"
          },
          "needsHumanReview": {
            "const": true
          },
          "sourceChecks": {
            "type": "object"
          }
        }
      }
    },
    "pdfVisualChecks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map",
        "quality",
        "report"
      ],
      "properties": {
        "map": {
          "type": "string",
          "minLength": 1
        },
        "quality": {
          "type": "string",
          "minLength": 1
        },
        "report": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ocrInventory": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
