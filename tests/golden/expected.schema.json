{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studysignal.local/schemas/golden-expected.json",
  "title": "Homework Analysis Golden expected.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "description",
    "photos",
    "analysisScope",
    "analysisConfidence",
    "coveredQuestions",
    "missingQuestions",
    "lowQualityQuestions",
    "expectedAnswerVerdict"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{3}_[a-z0-9_]+$",
      "description": "Must match folder name, e.g. 001_complete"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "photos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^photo[0-9]+\\.jpg$"
      },
      "description": "Filenames present in this golden folder"
    },
    "analysisScope": {
      "type": "string",
      "enum": ["full", "partial", "unknown"]
    },
    "analysisConfidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "coveredQuestions": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    },
    "missingQuestions": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    },
    "lowQualityQuestions": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    },
    "estimatedTotalQuestions": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional; when set, must equal covered + missing for known totals"
    },
    "expectedAnswerVerdict": {
      "type": "array",
      "items": { "$ref": "#/$defs/answerVerdict" }
    },
    "expectedFeedback": {
      "type": "array",
      "description": "Optional soft checks on generated feedback text",
      "items": { "$ref": "#/$defs/feedbackExpectation" }
    },
    "promptGuards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mustNotAnalyzeQuestions": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "description": "Questions that must never be evaluated as if evidenced"
        },
        "mustNotContain": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Forbidden substrings in Vision prompt / report when this fixture runs"
        },
        "mustContain": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "answerVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionNumber", "verdict"],
      "properties": {
        "questionNumber": { "type": "integer", "minimum": 1 },
        "verdict": {
          "type": "string",
          "enum": [
            "correct",
            "incorrect",
            "uncertain",
            "blank",
            "unevidenced"
          ],
          "description": "unevidenced = no QuestionEvidence; must not invent an answer"
        },
        "studentAnswer": { "type": ["string", "null"] },
        "expectedAnswer": { "type": ["string", "null"] },
        "isLowConfidence": { "type": "boolean" },
        "sourcePhoto": {
          "type": "string",
          "description": "e.g. photo1.jpg / Photo1"
        },
        "notes": { "type": "string" }
      }
    },
    "feedbackExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionNumber"],
      "properties": {
        "questionNumber": { "type": "integer", "minimum": 1 },
        "mustInclude": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mustNotInclude": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tone": {
          "type": "string",
          "enum": ["confident", "hedged", "unavailable"]
        }
      }
    }
  }
}
